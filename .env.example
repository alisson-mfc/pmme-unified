# ============================================================
# CHAVES API
# ============================================================
# Necessária apenas para rodar o pipeline (analise_matriculas + analise_logbook).
# Não é usada no Render — o app web em si não chama API de IA.
# Gere uma em: https://aistudio.google.com/apikey
GEMINI_API_KEY=AIzaSy...

# Token GitHub com escopo 'repo'. Necessário se pmme-dados for privado.
# Local: usado pelo pipeline pra fazer push (se Git não tiver outras creds).
# Render: necessário pra ler os JSONs do pmme-dados.
GITHUB_TOKEN=ghp_...

# ============================================================
# CONFIGURAÇÃO DE DADOS
# ============================================================
GITHUB_REPO=alisson-mfc/pmme-dados
GITHUB_BRANCH=main

# Onde buscar os dados:
#   auto    → tenta local primeiro, fallback pra remoto (default — bom em dev)
#   local   → só local (sibling pmme-dados/ ou dados/processado/)
#   remote  → só GitHub raw (use em prod no Render)
DATA_SOURCE=auto

# ============================================================
# MODELOS GEMINI (opcional — defaults são gemini-3.1-flash-lite)
# ============================================================
# GEMINI_MODEL_SENTIMENTO=gemini-3.1-flash-lite
# GEMINI_MODEL_RESUMO=gemini-3.1-flash-lite
# GEMINI_MODEL_TOPICOS=gemini-3.1-flash-lite

# ============================================================
# DEBUG
# ============================================================
DASH_DEBUG=true
